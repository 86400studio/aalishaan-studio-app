# Aalishaan Studio — environment variable NAMES only. Never put a real value in this file.
# The owner enters values in Vercel (Development / Preview / Production) or in a local .env.local, which Git
# ignores. Authoritative list: docs/TECH-ARCHITECTURE.md §6; per-environment values: docs/ENVIRONMENT-PARITY.md §4.

# --- Used from S0.1 ---------------------------------------------------------------------------------------

# Server-only. off | test | live. "off" in every scope until S3.4.
SALES_MODE=

# Public (inlined into the browser bundle). Sentry DSN of the one Sentry project; empty = monitoring off.
NEXT_PUBLIC_SENTRY_DSN=
# Server-only. The same DSN for server events; falls back to NEXT_PUBLIC_SENTRY_DSN when empty.
SENTRY_DSN=
# Build-only (Vercel Preview and Production builds). Source-map upload; never needed by local or CI checks.
SENTRY_AUTH_TOKEN=
# Build-only, not secret. Sentry organisation and project slugs for the source-map upload.
SENTRY_ORG=
SENTRY_PROJECT=
# (SENTRY_TEST_TOKEN, the S0.1 diagnostic route's token, was retired at S0.2: route removed, entries revoked.)

# --- Used from S0.2: Supabase (TEST project outside Production; PROD project in Production only) -------------

# Public. The project's API origin, exactly https://<ref>.supabase.co — TEST in Development/Preview/local,
# PROD in Production. Its ref must equal the matching *_PROJECT_REF below or every privileged path fails closed.
NEXT_PUBLIC_SUPABASE_URL=
# Public. The publishable key (sb_publishable_…) of the same project; never a secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only (Vercel Sensitive). The secret key (sb_secret_…) of the same project; bypasses RLS; never in browser code.
SUPABASE_SECRET_KEY=
# Server-only configuration, not secret: the two project refs (20 lower-case letters), the same in every scope.
# The trusted identity guard — never derived from a URL or a key. Production must point at the PROD ref,
# everything else at the TEST ref, and the two must differ.
SUPABASE_TEST_PROJECT_REF=
SUPABASE_PROD_PROJECT_REF=
# Server-only (Vercel Sensitive), PREVIEW SCOPE ONLY — never Production or Development. Bearer token of the
# Preview-only S0.2 proof route POST /api/setup-proof: at least 32 random characters; the trusted proof
# process (pnpm test:preview-proof) holds the same value. Removed and revoked by S1.1.
S0_2_PROOF_TOKEN=

# --- Not configured yet: later sprints add these. The S0.2 code never reads them. ----------------------------

# Public. Canonical site origin (D-04 domain in Production).
NEXT_PUBLIC_SITE_URL=
# Razorpay — S1.6 / S1.7 (test mode outside Production).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Shiprocket — S2.9 / S2.10.
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
# Transactional email — S1.8 (names become provider-specific once D-06 is decided).
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
# Cloudflare Turnstile — S1.6 (test keys entered at the S0.2 Gate 0; first read at S1.6).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash rate limiting — S1.2 / S1.6 (TEST database entered at the S0.2 Gate 0; first read at S1.2).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Worker route authentication — S1.8.
CRON_SECRET=

# --- Test harness — S0.2 (GitHub Actions / the owner's local shell only; never a Vercel variable of this app) --

# The immutable Preview deployment origin under test (https://…vercel.app; never the Production domain or a
# branch alias). No fallback: unset = the harness refuses to start. In local mode a loopback origin.
PLAYWRIGHT_BASE_URL=
# The full 40-character SHA of the candidate; matched against the GitHub deployment record before any request.
PLAYWRIGHT_CANDIDATE_SHA=
# preview (default) | local — local browser QA only, never Preview evidence; refuses to run with a Preview secret set.
PLAYWRIGHT_TARGET_MODE=
# The Protection Bypass for Automation secret (Vercel → Deployment Protection); sent only to the exact validated
# Preview origin, never in the browser, a URL, a log or a report.
VERCEL_AUTOMATION_BYPASS_SECRET=
# Optional, read-only. Only raises the GitHub API rate limit for the harness's deployment-evidence read of this
# public repository (60 unauthenticated requests per hour per address otherwise). Never required, never printed.
GITHUB_TOKEN=
