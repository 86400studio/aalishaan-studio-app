# Aalishaan Studio — environment variable NAMES only. Never put a real value in this file.
# The owner enters values in Vercel (Development / Preview / Production) or in a local .env.local, which Git
# ignores. Authoritative list: docs/TECH-ARCHITECTURE.md §6; per-environment values: docs/ENVIRONMENT-PARITY.md §4.

# --- Used from S0.1 ---------------------------------------------------------------------------------------

# Server-only. off | test | live. "off" in every scope until S3.4.
SALES_MODE=

# Public (inlined into the browser bundle). Sentry DSN of the one Sentry project; empty = monitoring off.
NEXT_PUBLIC_SENTRY_DSN=
# Server-only. The same DSN for server events; falls back to NEXT_PUBLIC_SENTRY_DSN when empty.
SENTRY_DSN=
# Build-only (Vercel Preview and Production builds). Source-map upload; never needed by local or CI checks.
SENTRY_AUTH_TOKEN=
# Build-only, not secret. Sentry organisation and project slugs for the source-map upload.
SENTRY_ORG=
SENTRY_PROJECT=
# Server-only, TEMPORARY (removed and revoked in S0.2). Bearer token for POST /api/sentry-test: at least 32
# random characters, a different value in each scope; empty = the diagnostic route is disabled.
SENTRY_TEST_TOKEN=

# --- Not configured yet: later sprints add these. The S0.1 scaffold never reads them. -----------------------

# Public. Canonical site origin (D-04 domain in Production).
NEXT_PUBLIC_SITE_URL=
# Supabase — S0.2 (TEST project outside Production).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Razorpay — S1.6 / S1.7 (test mode outside Production).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Shiprocket — S2.9 / S2.10.
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
# Transactional email — S1.8 (names become provider-specific once D-06 is decided).
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
# Cloudflare Turnstile — S1.6.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash rate limiting — S1.2 / S1.6.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Worker route authentication — S1.8.
CRON_SECRET=
# Test harness — S0.2 (GitHub Actions secrets / local shell only, never Vercel runtime).
PLAYWRIGHT_BASE_URL=
VERCEL_AUTOMATION_BYPASS_SECRET=
