{
  "name": "aalishaan-studio-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:e2e": "playwright test",
    "db:test:preflight": "node scripts/testing/preflight.mjs",
    "db:test:seed": "node scripts/testing/seed.mjs",
    "db:test:reset": "node scripts/testing/reset.mjs",
    "db:test:upload-catalogue": "node scripts/testing/upload-catalogue.mjs",
    "db:test:staff-users": "node scripts/testing/staff-users.mjs",
    "db:test:upload-site-images": "node scripts/testing/upload-site-images.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "10.76.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@sentry/cli",
      "sharp",
      "unrs-resolver"
    ]
  }
}
